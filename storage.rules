rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Blog images - authenticated users can upload
    match /image/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Contract templates (Word documents)
    match /contract-templates/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // DOCX templates for document generation
    match /docx-templates/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Contract documents - authenticated users can upload
    match /contracts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Contract wizard document uploads (public access for wizard)
    // Validation: only images and PDFs, max 10MB
    match /contract-documents/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
