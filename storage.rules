rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Blog images - authenticated users can upload
    match /image/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Contract templates (Word documents)
    match /contract-templates/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // DOCX templates for document generation
    match /docx-templates/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Contract documents - authenticated users can upload
    match /contracts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Contract wizard document uploads (ID card copies — personal data)
    // - list: only authenticated admins (no enumeration of uploads)
    // - get: admins always; the anonymous wizard only within 15 minutes of
    //   upload, so it can fetch the download URL right after uploadBytes.
    //   Stored download URLs (token URLs) keep working for the ops page.
    // - create only: no anonymous overwrite or delete of existing files
    // Validation: only images and PDFs, max 10MB
    match /contract-documents/{allPaths=**} {
      allow list: if request.auth != null;
      allow get: if request.auth != null
                 || request.time < resource.timeCreated + duration.value(15, 'm');
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
