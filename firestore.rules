rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff = a signed-in, verified e-mail that has an adminUsers/<id> document,
    // where <id> is the lower-cased e-mail with "." and "@" replaced by "_"
    // (the id AdminAuthProvider and the users page use).
    // Signing in alone is NOT enough: Google sign-in accepts any Google account.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function staffId() {
      return request.auth.token.email.lower().replace('[.@]', '_');
    }
    function staffPath() {
      return /databases/$(database)/documents/adminUsers/$(staffId());
    }
    function isStaff() {
      return signedIn() && exists(staffPath());
    }
    function isAdmin() {
      // A document without a role counts as admin, as the admin UI always did.
      return isStaff() && get(staffPath()).data.get('role', 'admin') == 'admin';
    }

    // Blog posts - public read, editors and admins write
    match /posts/{postId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Contracts (customer personal data) - public create (wizard), admin only otherwise
    match /contracts/{contractId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // DOCX templates - admin only
    match /docxTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // PDF form templates - admin only
    match /pdfFormTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Pricing cards - public read for wizard, admin write
    match /pricingCards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inquiries - public create, admin only otherwise
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Users - admin only
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Admin users - admins manage, everyone may read their own entry
    match /adminUsers/{userId} {
      allow read: if isAdmin() || (signedIn() && userId == staffId());
      allow write: if isAdmin();
    }

    // Email settings - admin only
    match /emailSettings/{docId} {
      allow read, write: if isAdmin();
    }

    // Marketing settings - public read (for scripts), admin write
    match /marketingSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
