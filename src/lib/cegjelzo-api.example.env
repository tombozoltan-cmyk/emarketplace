# Cégjelző API - a szükséges változók NEVE. Értéket ebbe a fájlba ne írj:
# ez a repó nyilvános, és ez a fájl verziókövetett.
#
# Hova kerül az érték:
#   - éles / App Hosting:  Secret Manager, az apphosting.yaml `secret:`
#                          bejegyzésén keresztül, `availability: [RUNTIME]`
#   - helyi fejlesztés:    .env.local, ami NINCS verziókövetve (.gitignore)
#
# Mindhárom változó SZERVEROLDALI. `NEXT_PUBLIC_` előtaggal egyiket se állítsd
# be: azt a Next a kliens-csomagba fordítja, tehát a kulcs kijutna a böngészőbe.
# (Ez a fájl korábban pont az ellenkezőjét tanácsolta, és a kulcs értékét is
# tartalmazta.)

# A keresés hosztja. Elhagyható: a kód alapértelmezése ugyanez.
# A szerződésünk ehhez a hoszthoz van kötve; a régi search.api.cegjelzo.com
# és a search-dev párja ugyanerre a kulcsra 403-at ad.
CEGJELZO_API_URL=https://api.cegjelzo.com

# A kulcs és a kliens-azonosító párban kapott, és együtt azonosítja azt a
# szerződést, ami megszabja, mely mezőket adhatja vissza a keresés.
# Értéket ide NE.
CEGJELZO_API_KEY=
CEGJELZO_CLIENT_ID=
