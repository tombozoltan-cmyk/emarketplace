# Cégjelző API Configuration
# Copy these values to your .env.local file

# =============================================================================
# TEST ENVIRONMENT (development)
# =============================================================================
# Base URL for test environment (default if not specified)
NEXT_PUBLIC_CEGJELZO_API_URL=https://search-dev.api.cegjelzo.com

# API key and Client ID
CEGJELZO_API_KEY=2rgmIN0yEY64tRfLdg0gY918rr047Q6b9u0ngf6A
CEGJELZO_CLIENT_ID=EMARKETPLACE-00001

# =============================================================================
# PRODUCTION ENVIRONMENT (go-live)
# =============================================================================
# Uncomment and use these for production:
# NEXT_PUBLIC_CEGJELZO_API_URL=https://search.api.cegjelzo.com
# CEGJELZO_API_KEY=<PROD_API_KEY>
# CEGJELZO_CLIENT_ID=EMARKETPLACE-00001

# =============================================================================
# Notes:
# - Test and production keys are different
# - Test environment: ~2000 requests/month, DB is 5-6 years old
# - Use CEGJELZO_API_KEY for server-side (secure, recommended)
# - Use NEXT_PUBLIC_CEGJELZO_API_KEY for client-side (exposed in browser)
