# A Cloud Functions beállításai. CSAK A VÁLTOZÓNEVEK - értéket ide soha ne írj,
# ez a repó nyilvános.
#
# Telepítéshez másold `functions/.env.<projectId>` néven (pl.
# functions/.env.emarketplace-8aab1), és töltsd ki. A .gitignore kizárja.
# A Brevo API-kulcs NEM ide tartozik: azt a kód `defineSecret`-tel kéri,
# és a Secret Managerben él.

# Ide érkezik az admin-értesítő a beadványokról
BREVO_TO_EMAIL=

# A kimenő levelek feladója
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# A tárgysor elé írt állandó szöveg
BREVO_SUBJECT_PREFIX=

# Válaszcím, ha eltér a feladótól
BREVO_REPLY_TO_EMAIL=
BREVO_REPLY_TO_NAME=

# Az admin felületre beengedett címek, vesszővel elválasztva
ADMIN_EMAILS=
